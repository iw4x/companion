define css: file
css{*}: extension = css

define xhtml: doc
xhtml{*}: extension = xhtml

# The documentation sources besides the command line definition. Note that
# file{} targets (and the css{} targets derived from it) are distributed but
# not installed.
#
./: file{man-*} style/{css{*} file{LICENSE}}

# The man page is generated from the command line definition
# (../companion/companion.cli) with the CLI compiler in the development
# build and distributed, so that the consumption build gets it without the
# compiler. It is never kept in the repository.
#

## Consumption build ($develop == false).
#

# Use the pregenerated versions, which only the distribution has.
#
./: pregenerated/{man1 xhtml}{*}: include = (!$develop)

# Distribute the pregenerated versions only in the consumption build.
#
pregenerated/{man1 xhtml}{*}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

./: {man1 xhtml}{companion}: include = $develop

if $develop
{
  import! [metadata] cli = cli%exe{cli}

  # Use the date of the last commit, so that the same revision always
  # produces the same documentation.
  #
  doc_date = $process.run(git -C $src_root log -1 '--format=%cd' \
                          '--date=format:%B %Y')

  doc_options = -v project=companion -v version=$version       \
                -v copyright='the IW4x authors' -v date="$doc_date" \
                --suppress-undocumented

  # The man page refers to the manual of libcompanion, which becomes plain
  # text in the man version and a link in the HTML version. The link is
  # relative to the installed documentation of libcompanion, which is next
  # to ours.
  #
  man_links  = --link-regex '%libcompanion-manual(#.+)?%$1%'
  html_links = --link-regex \
    '%libcompanion-manual(#.+)?%../libcompanion/libcompanion-manual.xhtml$1%'
}

# In the development build distribute the generated versions, remapping their
# locations to the paths of the pregenerated versions (which are only
# distributed in the consumption build, see above).
#
{man1 xhtml}{companion}: dist = ($develop ? pregenerated/ : false)

# The program only exists on Linux (see ../companion/buildfile), so its man
# page is only installed there.
#
if ($cxx.target.class != 'linux')
{
  {man1 xhtml}{companion}:              install = false
  pregenerated/{man1 xhtml}{companion}: install = false
}

man1{companion}: ../companion/cli{companion}            \
                 file{man-prologue.1 man-epilogue.1} $cli
%
if $develop
{{
  diag 'cli --man' ($<[0]) -> $>

  $cli $doc_options --generate-man --ascii-tree \
    $man_links                                  \
    --man-prologue-file $path($<[1])            \
    --man-epilogue-file $path($<[2])            \
    --stdout $path($<[0]) >$path($>)
}}

xhtml{companion}: ../companion/cli{companion}                      \
                  file{man-prologue.xhtml man-epilogue.xhtml}      \
                  style/css{common pre-box man} $cli
%
if $develop
{{
  diag 'cli --html' ($<[0]) -> $>

  $cli $doc_options --generate-html --html-suffix .xhtml \
    $html_links                                          \
    --html-prologue-file $path($<[1])                    \
    --html-epilogue-file $path($<[2])                    \
    --stdout $path($<[0]) >$path($>)
}}
