# The development build generates the documentation, which needs the CLI
# compiler (see doc/buildfile for details).
#
config [bool] config.libcompanion.develop ?= false
develop = $config.libcompanion.develop

# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

# MSVC only provides the C++23 parts of the standard library that we use
# (std::formattable, for example) in its /std:c++latest mode, which build2
# selects for `experimental` rather than `latest`. So we guess the compiler
# first and then request the standard.
#
using cxx.guess

cxx.std = ($cxx.id == 'msvc' ? experimental : latest)

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# C is needed for the vendored MinHook (see libcompanion/buildfile) and for
# the Linux companion module's 64-bit stand-in (see libcompanion/stub-linux.c).
#
using c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
