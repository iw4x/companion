# The target functions return x * 3 + 1 (a) and (x ^ 0x55) - 7 (b), and
# their detours add 1000 and 2000, respectively.
#

: initialize
:
$* initialize >>EOO
  initialize MH_OK
  initialize-again MH_ERROR_ALREADY_INITIALIZED
  uninitialize MH_OK
  uninitialize-again MH_ERROR_NOT_INITIALIZED
  EOO

: not-initialized
:
$* not-initialized >>EOO
  create MH_ERROR_NOT_INITIALIZED
  remove MH_ERROR_NOT_INITIALIZED
  enable MH_ERROR_NOT_INITIALIZED
  disable MH_ERROR_NOT_INITIALIZED
  queue-enable MH_ERROR_NOT_INITIALIZED
  queue-disable MH_ERROR_NOT_INITIALIZED
  apply MH_ERROR_NOT_INITIALIZED
  EOO

: hook
:
$* hook >>EOO
  initialize MH_OK
  create MH_OK
  call-disabled 16
  enable MH_OK
  call-enabled 1016
  call-original 16
  disable MH_OK
  call-disabled 16
  remove MH_OK
  uninitialize MH_OK
  EOO

: errors
:
$* errors >>EOO
  initialize MH_OK
  create-data MH_ERROR_NOT_EXECUTABLE
  enable-uncreated MH_ERROR_NOT_CREATED
  remove-uncreated MH_ERROR_NOT_CREATED
  queue-uncreated MH_ERROR_NOT_CREATED
  create MH_OK
  create-again MH_ERROR_ALREADY_CREATED
  disable-disabled MH_ERROR_DISABLED
  enable MH_OK
  enable-enabled MH_ERROR_ENABLED
  remove-enabled MH_OK
  call-removed 16
  uninitialize MH_OK
  EOO

: unmapped
:
: Test that an address the system cannot query is not executable.
:
$* unmapped >>EOO
  initialize MH_OK
  create-target MH_ERROR_NOT_EXECUTABLE
  create-detour MH_ERROR_NOT_EXECUTABLE
  uninitialize MH_OK
  EOO

: all
:
$* all >>EOO
  initialize MH_OK
  create-a MH_OK
  create-b MH_OK
  enable-all MH_OK
  call-a 1022
  call-b 2075
  disable-all MH_OK
  call-a 22
  call-b 75
  uninitialize MH_OK
  EOO

: queue
:
$* queue >>EOO
  initialize MH_OK
  create-a MH_OK
  create-b MH_OK
  queue-enable-all MH_OK
  queue-disable-a MH_OK
  call-a-queued 22
  call-b-queued 75
  apply MH_OK
  call-a 22
  call-b 2075
  uninitialize MH_OK
  EOO

: api
:
$* api >>EOO
  initialize MH_OK
  module-not-found MH_ERROR_MODULE_NOT_FOUND
  function-not-found MH_ERROR_FUNCTION_NOT_FOUND
  create MH_OK
  target 1
  enable MH_OK
  call-enabled 42
  call-original 1
  remove MH_OK
  uninitialize MH_OK
  EOO

: threads
:
$* threads >>EOO
  initialize MH_OK
  create MH_OK
  toggle 1
  uninitialize MH_OK
  EOO

: uninitialize
:
: Test that uninitializing disables the enabled hooks.
:
$* uninitialize >>EOO
  initialize MH_OK
  create MH_OK
  enable MH_OK
  uninitialize MH_OK
  call 16
  EOO

: strings
:
$* strings >>EOO
  MH_UNKNOWN
  MH_OK
  MH_ERROR_ALREADY_INITIALIZED
  MH_ERROR_NOT_INITIALIZED
  MH_ERROR_ALREADY_CREATED
  MH_ERROR_NOT_CREATED
  MH_ERROR_ENABLED
  MH_ERROR_DISABLED
  MH_ERROR_NOT_EXECUTABLE
  MH_ERROR_UNSUPPORTED_FUNCTION
  MH_ERROR_MEMORY_ALLOC
  MH_ERROR_MEMORY_PROTECT
  MH_ERROR_MODULE_NOT_FOUND
  MH_ERROR_FUNCTION_NOT_FOUND
  (unknown)
  EOO

: invalid
:
$* bogus 2>"error: invalid scenario 'bogus'" == 2
