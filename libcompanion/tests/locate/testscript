# All the PE tests start from this image, which contains the 1000 code
# section and the 2000 data section.
#
+cat <<EOI >=image
  section code 1000 1000
  section data 2000 100
  EOI

# Base ELF image for the i386 tests: code segment at 1000, data segment at
# 2000, writable segment at 3000 (which holds the GOT), and the ebx PC thunk
# at 1f00.
#
+cat <<EOI >=elf
  segment rx 1000 1000
  segment r 2000 100
  segment rw 3000 100
  thunk 1f00 ebx
  EOI

: found
:
: Test the typical x64 layout, with the reference near the function entry.
:
cat ../image - <<EOI | $* >'found 1000 1 1'
  anchor 2000
  function 1000 1200
  lea 1010 2000
  EOI

: no-anchor
:
cat ../image - <<EOI | $* >'no-anchor 0 0 0'
  function 1000 1200
  lea 1010 2000
  EOI

: anchor
:
{{
  : unterminated
  :
  : Test a longer name that starts with the anchor.
  :
  cat ../../image - <<EOI | $* >'no-anchor 0 0 0'
    string 2000 CWebSocketConnection::BBuildAndAsyncSendFrameEx
    function 1000 1200
    lea 1010 2000
    EOI

  : code
  :
  : Make sure the anchor is not searched for in code sections.
  :
  cat ../../image - <<EOI | $* >'no-anchor 0 0 0'
    anchor 1800
    function 1000 1200
    lea 1010 1800
    EOI

  : copies
  :
  : Test a reference to the second of two anchor copies.
  :
  cat ../../image - <<EOI | $* >'found 1000 1 1'
    anchor 2000
    anchor 2040
    function 1000 1200
    lea 1010 2040
    EOI

  : capacity
  :
  cat ../../image - <<EOI | $* >'found 1000 1 1'
    section data 3000 200
    anchor 3000
    anchor 3030
    anchor 3060
    anchor 3090
    anchor 30c0
    anchor 30f0
    anchor 3120
    anchor 3150
    function 1000 1200
    lea 1010 3150
    EOI

  : too-many
  :
  cat ../../image - <<EOI | $* >'ambiguous 0 0 0'
    section data 3000 200
    anchor 3000
    anchor 3030
    anchor 3060
    anchor 3090
    anchor 30c0
    anchor 30f0
    anchor 3120
    anchor 3150
    anchor 3180
    function 1000 1200
    lea 1010 3000
    EOI
}}

: no-reference
:
cat ../image - <<EOI | $* >'no-reference 0 0 0'
  anchor 2000
  function 1000 1200
  lea 1010 2001
  EOI

: lea
:
{{
  : register
  :
  : Test an extended destination register (REX.WR).
  :
  cat ../../image - <<EOI | $* >'found 1000 1 1'
    anchor 2000
    function 1000 1200
    lea 1010 2000 4c 3d
    EOI

  : operand-size
  :
  : Test a lea without REX.W, which is not a reference.
  :
  cat ../../image - <<EOI | $* >'no-reference 0 0 0'
    anchor 2000
    function 1000 1200
    lea 1010 2000 40
    EOI

  : addressing
  :
  : Test a ModRM that doesn't encode [rip + disp32].
  :
  cat ../../image - <<EOI | $* >'no-reference 0 0 0'
    anchor 2000
    function 1000 1200
    lea 1010 2000 48 45
    EOI

  : backward
  :
  : Test a negative displacement.
  :
  cat ../../image - <<EOI | $* >'found 3000 1 1'
    section code 3000 100
    anchor 2000
    function 3000 3100
    lea 3010 2000
    EOI

  : section-end
  :
  : Test a lea at the end of the section.
  :
  cat ../../image - <<EOI | $* >'found 1f00 1 1'
    anchor 2000
    function 1f00 2000
    lea 1ff9 2000
    EOI

  : data
  :
  : Make sure data sections are not scanned for references.
  :
  cat ../../image - <<EOI | $* >'no-reference 0 0 0'
    section data 3000 100
    anchor 2000
    lea 3010 2000
    EOI
}}

: distance
:
{{
  : limit
  :
  cat ../../image - <<EOI | $* >'found 1000 1 1'
    anchor 2000
    function 1000 1200
    lea 1100 2000
    EOI

  : inlined
  :
  : Test a reference past max_scope_distance, the way a function that
  : inlines the send function would have it.
  :
  cat ../../image - <<EOI | $* >'no-candidate 0 1 0'
    anchor 2000
    function 1000 1200
    lea 1101 2000
    EOI

  : inlined-and-not
  :
  cat ../../image - <<EOI | $* >'found 1400 2 1'
    anchor 2000
    function 1000 1200
    function 1400 1500
    lea 1180 2000
    lea 1420 2000
    EOI
}}

: function
:
{{
  : none
  :
  : Test a reference outside any function.
  :
  cat ../../image - <<EOI | $* >'no-candidate 0 1 0'
    anchor 2000
    function 1000 1200
    lea 1210 2000
    EOI

  : twice
  :
  : Test two references in the same function.
  :
  cat ../../image - <<EOI | $* >'found 1000 2 1'
    anchor 2000
    function 1000 1200
    lea 1010 2000
    lea 1020 2000
    EOI

  : ambiguous
  :
  cat ../../image - <<EOI | $* >'ambiguous 0 2 2'
    anchor 2000
    function 1000 1200
    function 1400 1500
    lea 1010 2000
    lea 1410 2000
    EOI

  : chained
  :
  : Test a reference in a function part with a chained entry (for example,
  : after a shrink-wrapped prologue).
  :
  cat ../../image - <<EOI | $* >'found 1000 1 1'
    anchor 2000
    function 1000 1008
    function 1008 1200 1000
    lea 1010 2000
    EOI

  : chained-cold
  :
  : Test a reference located ahead of the primary entry (a cold block).
  :
  cat ../../image - <<EOI | $* >'no-candidate 0 1 0'
    anchor 2000
    function 1000 1040 1400
    function 1400 1500
    lea 1010 2000
    EOI
}}

: i386
:
{{
  test.options += --elf

  : found
  :
  : Test the typical i386 layout, with a thunk-based GOT load and a
  : GOT-relative reference.
  :
  cat ../../elf - <<EOI | $* >'found 1000 1 1'
    anchor 2000
    function 1000 1200
    load 1004 ebx 3000 1f00
    lea 1100 2000 3000
    EOI

  : no-anchor
  :
  cat ../../elf - <<EOI | $* >'no-anchor 0 0 0'
    function 1000 1200
    load 1004 ebx 3000 1f00
    lea 1100 2000 3000
    EOI

  : anchor
  :
  {{
    : code
    :
    : Make sure the anchor is not searched for in code segments.
    :
    cat ../../../elf - <<EOI | $* >'no-anchor 0 0 0'
      anchor 1800
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 1800 3000
      EOI

    : writable
    :
    cat ../../../elf - <<EOI | $* >'found 1000 1 1'
      anchor 3080
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 3080 3000
      EOI
  }}

  : got
  :
  {{
    : pop
    :
    : Test the Clang GOT load (call to the next instruction and pop).
    :
    cat ../../../elf - <<EOI | $* >'found 1000 1 1'
      anchor 2000
      function 1000 1200
      load 1004 eax 3000
      lea 1100 2000 3000 80
      EOI

    : late
    :
    : Test a GOT load after the reference.
    :
    cat ../../../elf - <<EOI | $* >'found 1000 1 1'
      anchor 2000
      function 1000 1200
      load 1180 ebx 3000 1f00
      lea 1100 2000 3000
      EOI

    : none
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      lea 1100 2000 3000
      EOI

    : outside
    :
    : Make sure a GOT load outside any function is ignored.
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      load 1400 ebx 3000 1f00
      lea 1100 2000 3000
      EOI

    : unwritable
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 2080 1f00
      lea 1100 2000 2080
      EOI

    : first
    :
    : Make sure the GOT is determined by the first load that is inside a
    : function.
    :
    cat ../../../elf - <<EOI | $* >'no-reference 0 0 0'
      anchor 2000
      function 1000 1200
      function 1400 1600
      load 1004 ebx 3000 1f00
      load 1404 ebx 3010 1f00
      lea 1500 2000 3010
      EOI

    : pop-esp
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 esp 3000
      lea 1100 2000 3000
      EOI

    : add-register
    :
    : Test an add to a register other than the one the thunk loads.
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      thunk 1f10 ecx
      load 1004 ebx 3000 1f10
      lea 1100 2000 3000
      EOI
  }}

  : thunk
  :
  {{
    : ret
    :
    : Test a thunk candidate that ends with ret imm16.
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000
      byte 1f03 c2
      EOI

    : esp
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      thunk 1f10 esp
      load 1004 esp 3000 1f10
      lea 1100 2000 3000
      EOI

    : data
    :
    : Test a thunk in a data segment.
    :
    cat ../../../elf - <<EOI | $* >'no-got 0 0 0'
      anchor 2000
      function 1000 1200
      thunk 2080 ebx
      load 1004 ebx 3000 2080
      lea 1100 2000 3000
      EOI
  }}

  : lea
  :
  {{
    : register
    :
    : Test a base register other than ebx (esi).
    :
    cat ../../../elf - <<EOI | $* >'found 1000 1 1'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000 86
      EOI

    : sib
    :
    : Test a ModRM that requires a SIB byte.
    :
    cat ../../../elf - <<EOI | $* >'no-reference 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000 84
      EOI

    : displacement
    :
    : Test a ModRM with an 8-bit displacement.
    :
    cat ../../../elf - <<EOI | $* >'no-reference 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000 43
      EOI

    : target
    :
    cat ../../../elf - <<EOI | $* >'no-reference 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2001 3000
      EOI

    : segment-end
    :
    : Test a lea at the end of the segment.
    :
    cat ../../../elf - <<EOI | $* >'found 1e00 1 1'
      anchor 2000
      function 1e00 2000
      load 1e04 ebx 3000 1f00
      lea 1ffa 2000 3000
      EOI

    : data
    :
    : Make sure data segments are not scanned for references.
    :
    cat ../../../elf - <<EOI | $* >'no-reference 0 0 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 2080 2000 3000
      EOI
  }}

  : function
  :
  {{
    : none
    :
    : Test a reference outside any function.
    :
    cat ../../../elf - <<EOI | $* >'no-candidate 0 1 0'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1300 2000 3000
      EOI

    : no-load
    :
    : Test a referencing function that doesn't load the GOT.
    :
    cat ../../../elf - <<EOI | $* >'no-candidate 0 1 0'
      anchor 2000
      function 1000 1200
      function 1400 1600
      load 1004 ebx 3000 1f00
      lea 1500 2000 3000
      EOI

    : other-got
    :
    : Test a referencing function that loads a different GOT.
    :
    cat ../../../elf - <<EOI | $* >'no-candidate 0 1 0'
      anchor 2000
      function 1000 1200
      function 1400 1600
      load 1004 ebx 3000 1f00
      load 1404 ebx 3010 1f00
      lea 1500 2000 3000
      EOI

    : twice
    :
    cat ../../../elf - <<EOI | $* >'found 1000 2 1'
      anchor 2000
      function 1000 1200
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000
      lea 1110 2000 3000
      EOI

    : ambiguous
    :
    cat ../../../elf - <<EOI | $* >'ambiguous 0 2 2'
      anchor 2000
      function 1000 1200
      function 1400 1600
      load 1004 ebx 3000 1f00
      load 1404 ebx 3000 1f00
      lea 1100 2000 3000
      lea 1500 2000 3000
      EOI

    : personality
    :
    : Test a function whose CIE has a personality routine (typical for
    : C++).
    :
    cat ../../../elf - <<EOI | $* >'found 1000 1 1'
      anchor 2000
      function 1000 1200 personality
      load 1004 ebx 3000 1f00
      lea 1100 2000 3000
      EOI
  }}
}}
