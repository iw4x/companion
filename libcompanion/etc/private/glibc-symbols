# Print the glibc symbol version bindings header of the Linux companion
# module (libcompanion/libcompanion/glibc-linux.hxx) to stdout.
#
# Usage: libcompanion/etc/private/glibc-symbols <floor> <library>...
#
# For each symbol defined by the libraries the header binds the symbol to its
# latest version at the floor. The libraries must belong to an i386 glibc
# (the module's architecture) of the floor version or later. For example, on
# Fedora (glibc.i686):
#
#   libcompanion/etc/private/glibc-symbols 2.36 \
#     /usr/lib/libc.so.6 /usr/lib/libm.so.6 /usr/lib/ld-linux.so.2 \
#     >libcompanion/libcompanion/glibc-linux.hxx
#
# Symbols that don't exist at the floor are omitted. If the module
# references one of them, then the floor test fails (see
# glibc-linux.testscript).
#
usage="usage: libcompanion/etc/private/glibc-symbols <floor> <library>..."

set -o errexit

diag ()
{
  echo "$*" 1>&2
}

if [ "$#" -lt 2 ]; then
  diag "$usage"
  exit 1
fi

floor="$1"
shift

if ! echo "$floor" | grep -Eq '^[0-9]+\.[0-9]+$'; then
  diag "invalid floor '$floor'"
  diag "$usage"
  exit 1
fi

for l in "$@"; do
  if [ ! -f "$l" ]; then
    diag "'$l' does not exist"
    exit 1
  fi
done

# Determine the source glibc version for the generated header. Note that we
# extract it from the first library, which must therefore be libc.so.6.
#
source="$(grep -aoE -m 1 'release version [0-9]+\.[0-9]+(\.[0-9]+)?' "$1" | \
  sed -e 's/.* //')"

if [ -z "$source" ]; then
  diag "no glibc version in '$1', is it libc.so.6?"
  exit 1
fi

# Note: each stage runs as a separate command so that errexit detects its
# failure (sh has no pipefail).
#
symbols="$(objdump -T "$@")"

# Each objdump -T symbol line contains the value, flags, section, size,
# version (in parentheses if hidden, that is, non-default), and name. Other
# lines are headings or blank. We skip undefined symbols (they belong to
# other libraries) and versions other than GLIBC_<major>.<minor>[.<patch>]
# (for example, GLIBC_PRIVATE and Base).
#
pins="$(printf '%s\n' "$symbols" | awk -v floor="$floor" '
function compare (a, b,    x, y, n, i)
{
  n = split (a, x, ".")
  if (split (b, y, ".") > n)
    n = length (y)

  for (i = 1; i <= n; i++)
  {
    if (x[i] + 0 != y[i] + 0)
      return x[i] + 0 < y[i] + 0 ? -1 : 1
  }

  return 0
}

NF < 3 || /\*UND\*/ { next }

{
  v = $(NF - 1)
  s = $NF

  gsub (/[()]/, "", v)

  if (v !~ /^GLIBC_[0-9]+\.[0-9]+(\.[0-9]+)?$/ || s == v)
    next

  n = substr (v, 7)

  if (compare(n, floor) > 0)
    next

  if (!(s in best) || compare(n, best[s]) > 0)
    best[s] = n
}

END {
  for (s in best)
    printf "__asm__ (\".symver %s,%s@GLIBC_%s\");\n", s, s, best[s]
}')"

if [ -z "$pins" ]; then
  diag "no symbols in $*"
  exit 1
fi

cat <<EOF
// Copyright (c) the IW4x authors (see the AUTHORS file).
// SPDX-License-Identifier: GPL-3.0-only

// glibc symbol version bindings of the Linux companion module for the glibc
// $floor floor (see glibc-linux.cxx).
//
// Generated by libcompanion/etc/private/glibc-symbols $floor from glibc
// $source (i386). To change, regenerate this file.
//
// By default a glibc symbol reference binds to the latest version of the
// symbol in the glibc used for the build, which can exceed the glibc on the
// Steam client's host. Every translation unit of the module includes this
// header first (-include), which binds each symbol to its latest version at
// the floor.
//
#pragma once

EOF

printf '%s\n' "$pins" | LC_ALL=C sort
