intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# Vendored MinHook (see LEGAL).
#
# We build two utility libraries from it. The first is HDE, MinHook's
# instruction length decoder, which the library uses on every target (see
# detour.hxx). The second is the rest of MinHook, the hooking engine of the
# Windows module.
#
# Upstream compiles each HDE decoder only for the matching architecture
# since MinHook decodes the code of its own process. The library decodes
# i386 code on every host, so hde32-portable.c builds the i386 decoder for
# every target. It includes hde32.c, which is therefore not compiled on its
# own.
#
libul{hde}: minhook/c{hde32-portable hde64} \
  minhook/h{hde32 hde64 pstdint table32 table64 windows}
libul{hde}: minhook/c{hde32}: include = adhoc

# Note that libul{minhook} depends on HDE without listing it. Its only user,
# the Windows module, also links libul{companion}, which lists HDE. A utility
# library is linked in full at every point where it is reached, so listing
# HDE in both would define its symbols twice.
#
libul{minhook}: minhook/h{minhook buffer trampoline} \
  minhook/c{minhook buffer trampoline}

# The library excludes the companion modules' platform code (*-win32 and
# *-linux), which keeps it platform-independent and testable on any host.
#
./: lib{companion}: libul{companion}: \
  {hxx ixx txx cxx}{** -version -*-win32 -*-linux} \
  hxx{version} libul{hde} $impl_libs $intf_libs

hxx{version}: in{version} $src_root/manifest

# Windows companion module that is loaded into the Steam client (see
# host-win32.cxx and attach-win32.cxx).
#
# The game expects the module next to iw4x.dll under a fixed name (see
# companion_module_name), so the name has no lib prefix or version.
#
windows = ($cxx.target.class == 'windows')

./: libs{iw4x-steam64}: include = $windows

libs{iw4x-steam64}: {hxx txx cxx}{*-win32} libul{companion} \
  libul{minhook}
{
  bin.lib.prefix = ''
  bin.lib.suffix = ''
  install        = bin/
}

# The module is loaded into processes whose DLL search path we don't control
# (the Steam client and rundll32), so link the MinGW runtime statically.
# This only applies to the module.
#
if ($cxx.target.system == 'mingw32')
  libs{iw4x-steam64}: cxx.loptions += -static


# Linux companion module that the launcher preloads into the Steam client
# (see host-linux.cxx and iw4x-steam.in).
#
# The Linux Steam client is 32-bit, so the module is only built for i386
# targets. The launcher expects a fixed name, so the name has no version.
#
# Note that GCC reports the -m32 target only if it is built with multiarch
# support (Debian, Ubuntu). On other distributions (Fedora, Arch) also
# specify the target explicitly. For example:
#
#   config.cxx='g++ -m32' config.cxx.target=i686-linux-gnu \
#   config.c='gcc -m32'   config.c.target=i686-linux-gnu
#
# Without it the target is detected as x86_64 and the build fails (see
# stub-linux.c).
#
# The launcher preloads the module from lib/iw4x-steam/$PLATFORM/, which the
# dynamic linker expands separately in each process. In an i386 process
# $PLATFORM is i686. In an x86_64 process it is x86_64 or, if glibc detects
# a CPU of the corresponding class, haswell or xeon_phi. Each of these three
# directories contains an empty stand-in built for x86_64 targets, which the
# 64-bit programs that start the Steam client load (see stub-linux.c).
#
linux  = ($cxx.target.class == 'linux')
i386   = $regex.match($cxx.target.cpu, 'i[3-6]86')
x86_64 = ($cxx.target.cpu == 'x86_64')

./: libs{iw4x-steam}: include = ($linux && $i386)

libs{iw4x-steam}: {hxx txx cxx}{*-linux} libul{companion}
{
  bin.lib.suffix = ''
  install        = lib/iw4x-steam/i686/
}

for p: x86_64 haswell xeon_phi
{
  ./: $p/libs{iw4x-steam}: include = ($linux && $x86_64)

  $p/libs{iw4x-steam}: c{stub-linux} fsdir{$p/}
  {
    bin.lib.suffix = ''
    install        = lib/iw4x-steam/$p/
  }
}

# Launcher that is installed with the module. It locates the module
# relative to its own installation location, so it is only built when
# installing.
#
./: exe{iw4x-steam}: include = ($linux && $i386 && $install.root != [null])

exe{iw4x-steam}: in{iw4x-steam}
{
  in.symbol = '@'
}

ifn! $install.root
  exe{iw4x-steam}: module_dir = \
    $install.resolve($install.lib, $install.bin)iw4x-steam

# The modules are only loaded, never linked, so we install the libraries
# without the development files (import library and pkg-config files).
#
# Note: we use patterns because a target name here would declare the
# member ahead of its link rule. The libi{} import library is Windows-only.
#
{pc pcs}{iw4x-steam*}: install = false

if $windows
  libi{iw4x-steam*}: install = false

# A preloaded library is first in the symbol lookup scope of the process,
# so each symbol it exports interposes the Steam client's symbol with the
# same name. This includes the statically linked C++ runtime (see below) as
# well as the template instantiations and inline functions that the module
# shares with the client (for example, of std::basic_string). So the version
# script makes all the module's symbols local, including those from our
# objects, from libul{companion}, and from the runtime archives. The module
# requires no exports since the dynamic linker calls its constructor
# directly (see host-linux.cxx).
#
# The Steam client runs against the Steam Runtime's libstdc++, which can
# predate the one we build with, so the module carries its own runtime.
#
libs{iw4x-steam}: file{iw4x-steam.map}: include = adhoc

# Verify the module's glibc symbol versions (see glibc-linux.cxx).
#
libs{iw4x-steam}: testscript{glibc-linux}

if ($linux && $i386)
{
  libs{iw4x-steam}:
  {
    cxx.loptions += -static-libstdc++ -static-libgcc \
                    "-Wl,--version-script=$src_base/iw4x-steam.map"
    cxx.libs += -ldl
  }
}

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

obja{*}: cxx.poptions += -DLIBCOMPANION_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBCOMPANION_SHARED_BUILD

# The Linux module exports nothing (see libs{iw4x-steam} above), so its code
# is compiled with hidden visibility. On i386 this makes calls and data
# references to its own symbols bypass the GOT and the PLT.
#
# The module's code also includes glibc-linux.hxx, which binds its glibc
# references to the versions available in glibc 2.36 (see glibc-linux.cxx).
#
objs{*-linux}:
{
  cxx.poptions += -include "$src_base/glibc-linux.hxx"
  cxx.coptions += -fvisibility=hidden
}

# HDE includes <windows.h> for its integer types only. So the HDE objects
# and the detour builder, which includes <hde32.h>, are compiled against the
# stand-in on every target, including Windows (see minhook/windows.h). The
# rest of MinHook and the Windows module use the real <windows.h>.
#
# Note: the detour builder's options are set on the group members since a
# value on obj{detour} would be found before the obja{*} and objs{*} appends
# above and hide them.
#
minhook/obj{hde32-portable hde64}: c.poptions =+ "-I$src_base/minhook"

{obja objs obje}{detour}: cxx.poptions =+ "-I$src_base/minhook"

# Export options.
#
lib{companion}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

liba{companion}: cxx.export.poptions += -DLIBCOMPANION_STATIC
libs{companion}: cxx.export.poptions += -DLIBCOMPANION_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{companion}: bin.lib.version = "-$version.project_id"
else
  lib{companion}: bin.lib.version = "-$version.major.$version.minor"

# Install into the libcompanion/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
{hxx ixx txx}{*}:
{
  install         = include/libcompanion/
  install.subdirs = true
}

# The companion modules' platform headers and MinHook's headers are internal
# and not installed.
#
{hxx txx}{*-win32 *-linux}: install = false
h{*}:                       install = false
