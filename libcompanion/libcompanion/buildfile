intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

tclass = $cxx.target.class
tsys   = $cxx.target.system
tcpu   = $cxx.target.cpu

windows = ($tclass == 'windows')
linux   = ($tclass == 'linux')

i386   = $regex.match($tcpu, 'i[3-6]86')
x86_64 = ($tcpu == 'x86_64')

# We keep the modules' platform code out of the library so that we can build
# and test it on any host. For the same reason we build MinHook's
# instruction length decoder for every target (see detour.hxx).
#
./: lib{companion}: libul{companion}: \
  {hxx ixx txx cxx}{** -version -*-win32 -*-linux -glibc} hxx{version} \
  minhook/{h c}{hde32 hde64} minhook/h{table32 table64}               \
  $impl_libs $intf_libs

libul{companion}: minhook/{h c}{minhook buffer trampoline}: include = $windows

hxx{version}: in{version} $src_root/manifest

# The library code doesn't mark its exports (see export.hxx), so on Windows
# we export every symbol. Note that we set the MinGW option on the library
# since the Windows module exports its attach entry point alone.
#
libs{companion}: def{companion}: include = ($tsys == 'win32-msvc')
def{companion}: libul{companion}

if ($tsys == 'mingw32')
  libs{companion}: cxx.loptions += -Wl,--export-all-symbols

# The Windows module is loaded into the 64-bit Steam client. The game looks
# for it under a fixed name (see companion_module_name), so we fix the name
# prefix and suffix that config.bin.lib.* would otherwise set.
#
./: libs{companion64}: include = ($windows && $x86_64)

libs{companion64}: {hxx txx cxx}{*-win32} libul{companion}
{
  bin.lib.prefix = ''
  bin.lib.suffix = ''
}

# We don't control the DLL search path of the processes that load the module
# (the Steam client and rundll32), so with MinGW we link its runtime
# statically. With MSVC the runtime is a compile option (/MT) of the object
# files that the module shares with the library, so we leave it to the build
# configuration.
#
if ($tsys == 'mingw32')
  libs{companion64}: cxx.loptions += -static

# The Linux module is preloaded into the 32-bit Steam client from
# lib/companion/$PLATFORM/ (see companion.in). In the 64-bit programs that
# start the client $PLATFORM is x86_64, haswell, or xeon_phi, and the
# directory contains an empty stand-in (see stub-linux.c). These libraries
# share the file name, so we build each in the subdirectory that we install
# it into, with the name prefix and suffix fixed as for the Windows module.
#
./: i686/libs{companion}: include = ($linux && $i386)

i686/libs{companion}: {hxx txx cxx}{*-linux} {hxx cxx}{glibc} \
                       libul{companion} fsdir{i686/}
{
  bin.lib.prefix = lib
  bin.lib.suffix = ''
  install        = lib/companion/i686/
}

for p: x86_64 haswell xeon_phi
{
  ./: $p/libs{companion}: include = ($linux && $x86_64)

  $p/libs{companion}: c{stub-linux} fsdir{$p/}
  {
    bin.lib.prefix = lib
    bin.lib.suffix = ''
    install        = lib/companion/$p/
  }
}

# A preloaded library's exports interpose the Steam client's symbols of the
# same name, including those of the C++ runtime and of the template
# instantiations that both share. So the version script makes every symbol
# of the module local (its constructor needs no export).
#
# The Steam Runtime's libstdc++ can predate the one we build with, so the
# module carries its own runtime.
#
i686/libs{companion}: file{companion.map}: include = adhoc

i686/libs{companion}:
{
  cxx.loptions += -static-libstdc++ -static-libgcc \
                  "-Wl,--version-script=$src_base/companion.map"
  cxx.libs += -ldl
}

i686/libs{companion}: testscript{glibc}

# The launcher locates the module relative to its own installation
# location, so we only build it when installing. The script expands $
# variables itself, so we substitute @-delimited ones.
#
./: exe{companion}: include = ($linux && $i386 && $install.root != [null])

exe{companion}: in{companion}
{
  in.symbol = '@'
}

ifn! $install.root
  exe{companion}: module_dir = \
    $install.resolve($install.lib, $install.bin)companion

# Nothing links the modules, so we don't install their development files.
#
# Note that we use patterns since naming these ad hoc members here would
# declare them ahead of their link rule.
#
{pc pcs}{companion64*}: install = false

if $windows
  libi{companion64*}: install = false

for p: i686 x86_64 haswell xeon_phi
  $p/{pc pcs}{*}: install = false

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"
c.poptions   =+ "-I$src_root"

obja{*}: cxx.poptions += -DLIBCOMPANION_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBCOMPANION_SHARED_BUILD

# The Linux module's code binds its glibc references to glibc 2.36 (see
# glibc.cxx) and uses the 64-bit file interface since tmpfs and btrfs can
# assign inode numbers that overflow the i386 one. The module exports
# nothing, so hidden visibility lets its own references bypass the GOT and
# the PLT.
#
objs{*-linux glibc}:
{
  cxx.poptions += -include "$src_base/glibc.hxx" -D_FILE_OFFSET_BITS=64
  cxx.coptions += -fvisibility=hidden
}

# Export options.
#
lib{companion}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

liba{companion}: cxx.export.poptions += -DLIBCOMPANION_STATIC
libs{companion}: cxx.export.poptions += -DLIBCOMPANION_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{companion}: bin.lib.version = "-$version.project_id"
else
  lib{companion}: bin.lib.version = "-$version.major.$version.minor"

# Install into the libcompanion/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
{hxx ixx txx h}{*}:
{
  install         = include/libcompanion/
  install.subdirs = true
}

# Only the modules include their platform headers and only MinHook includes
# its internal ones. The MinHook API is only built for Windows.
#
{hxx txx}{*-win32 *-linux}: install = false
hxx{glibc}@./:              install = false

minhook/
{
  h{buffer}@./ h{trampoline}@./ h{table32}@./ h{table64}@./: install = false

  if! $windows
    h{minhook}@./: install = false
}
