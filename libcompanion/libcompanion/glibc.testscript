# glibc floor test (see glibc.cxx). Print the module's dynamic symbols
# with versions above GLIBC_2.36. The expected output is empty.
#
# Note that objdump is part of binutils, which the toolchain includes.
#

: floor
:
objdump -T $0 | \
  sed -n -e 's/^(.*GLIBC_2\.(3[7-9]|[4-9][0-9]|[1-9][0-9]{2,}).*)$/\1/p'
